{
  "name": "speedy-dispatcher",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"require('node:assert/strict').equal(process.versions.node, require('./package.json').engines.node, 'Use the pinned Node.js runtime before building')\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test --test-concurrency=1 src/*.test.ts tests/*.test.mjs",
    "check": "npm run lint && npm test && npm run build",
    "start": "node server.mjs",
    "preview": "node server.mjs",
    "preview:local": "vite preview"
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.2.2"
  }
}
