{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TLSRequired",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::REPLACE_BUCKET", "arn:aws:s3:::REPLACE_BUCKET/*"],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    },
    {
      "Sid": "RequireCreateOnlyWrites",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/*",
      "Condition": { "StringNotEquals": { "s3:if-none-match": "*" } }
    },
    {
      "Sid": "RequireExplicitSSES3",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/*",
      "Condition": { "StringNotEquals": { "s3:x-amz-server-side-encryption": "AES256" } }
    },
    {
      "Sid": "NoDeletionOfActiveProductionHistory",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/production/*"
    },
    {
      "Sid": "RuntimeAndMaintenanceCannotChangeTrustControls",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:PutBucket*", "s3:DeleteBucket*", "s3:PutEncryptionConfiguration", "s3:PutLifecycleConfiguration", "s3:PutReplicationConfiguration"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET",
      "Condition": { "ArnEquals": { "aws:PrincipalArn": ["arn:aws:iam::REPLACE_ACCOUNT_ID:role/SpeedyPrivacyJournalApplication", "arn:aws:iam::REPLACE_ACCOUNT_ID:role/SpeedyPrivacyJournalOperator"] } }
    }
  ]
}
