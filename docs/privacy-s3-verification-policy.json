{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TemporaryExactSyntheticRunInventory",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions"],
      "Resource": "arn:aws:s3:::speedy-sweeties-privacy-decisions-080413009273",
      "Condition": { "StringLike": { "s3:prefix": "verification/recovery-integration-20261028/*" } }
    },
    {
      "Sid": "TemporarySyntheticJournalOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::speedy-sweeties-privacy-decisions-080413009273/verification/recovery-integration-20261028/*"
    }
  ]
}
