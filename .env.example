NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/speedy_sweeties?schema=public"
# Comma-separated browser origins permitted to call the API.
CORS_ORIGIN="http://localhost:3000,https://speedy-sweeties.webflow.io,https://www.speedysweeties.ca"

# Existing business-hours Places lookup (server-only).
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID="ChIJBSxQSViaK4gRaS6LjGPMvTs"

# Authoritative order-address geocoding (server-only; enable Geocoding API).
GOOGLE_GEOCODING_API_KEY=""
GOOGLE_GEOCODING_TIMEOUT_MS=5000

# Dispatcher routing preview (server-only; enable Routes API).
GOOGLE_ROUTES_API_KEY=""
GOOGLE_ROUTES_TIMEOUT_MS=6000
ROUTING_PREVIEW_CACHE_SECONDS=45
